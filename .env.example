# Project
PROJECT_NAME=VivaCripto API
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS
CORS_ORIGINS=http://localhost:3000,https://vivacripto.com.br

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vivacripto

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Service Tokens
AUTOMATION_TOKEN=automation-service-token-change-in-production
REVALIDATE_SECRET=revalidation-secret-change-in-production

# OpenAI
OPENAI_API_KEY=sk-...

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Automation
DAILY_POST_LIMIT=10
AUTOMATION_INTERVAL_MINUTES=30

# External APIs
CRYPTOPANIC_API_KEY=your-cryptopanic-key

# Frontend
FRONTEND_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
