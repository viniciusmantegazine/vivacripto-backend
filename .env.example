# Project
PROJECT_NAME=VerticeCripto API
VERSION=1.0.0
API_V1_STR=/api/v1

# Environment Mode
# Set DEBUG=true apenas para desenvolvimento local. Em produção, mantenha false ou remova.
# Quando DEBUG=false, secrets inseguros causam erro na inicialização.
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:3000,https://verticecripto.com.br

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/verticecripto

# Security - IMPORTANTE: Gere chaves seguras para produção!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua-chave-secreta-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Service Tokens - IMPORTANTE: Gere tokens seguros para produção!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOMATION_TOKEN=seu-token-de-automacao-minimo-32-caracteres
REVALIDATE_SECRET=seu-secret-de-revalidacao-seguro

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GEMINI_API_KEY=

# Anthropic Claude (para relatórios semanais)
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Automation
DAILY_POST_LIMIT=10
AUTOMATION_INTERVAL_MINUTES=30

# External APIs
CRYPTOPANIC_API_KEY=your-cryptopanic-key

# Frontend
FRONTEND_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=

# ====== Social Media Publishing ======
# Habilita publicação automática nas redes sociais
SOCIAL_PUBLISHING_ENABLED=false

# Twitter/X API
# Obtenha suas credenciais em: https://developer.twitter.com
TWITTER_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Instagram Graph API (futuro)
# Requer: conta Business + Facebook Page + App no Facebook Developers
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
